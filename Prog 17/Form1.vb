Public Class Form1

    ' Событие Paint автоматически отрисовывает графику при появлении окна
    Private Sub Form1_Paint(sender As Object, e As PaintEventArgs) Handles Me.Paint
        Dim Граф As Graphics = e.Graphics

        ' Общая линия горизонта (земля)
        Граф.DrawLine(Pens.Black, 20, 350, 650, 350)

        ' ==========================================
        ' 1. ВЕЛОСИПЕД (левая часть)
        ' ==========================================
        Граф.DrawEllipse(Pens.Black, 50, 250, 100, 100)  ' Заднее колесо
        Граф.DrawEllipse(Pens.Black, 200, 250, 100, 100) ' Переднее колесо

        ' Рама
        Граф.DrawLine(Pens.Black, 100, 300, 150, 200) ' Подседельная труба
        Граф.DrawLine(Pens.Black, 100, 300, 175, 300) ' Нижнее перо
        Граф.DrawLine(Pens.Black, 175, 300, 225, 200) ' Нижняя труба
        Граф.DrawLine(Pens.Black, 150, 200, 225, 200) ' Верхняя труба

        ' Руль, вилка и сиденье
        Граф.DrawLine(Pens.Black, 250, 300, 210, 150) ' Вилка и рулевая колонка
        Граф.DrawLine(Pens.Black, 190, 160, 230, 150) ' Ручки руля
        Граф.DrawEllipse(Pens.Black, 130, 190, 40, 10) ' Сиденье

        ' ==========================================
        ' 2. ЧЕЛОВЕЧЕК (по центру)
        ' ==========================================
        Граф.DrawLine(Pens.Black, 330, 350, 330, 270) ' Левая нога
        Граф.DrawLine(Pens.Black, 350, 350, 350, 270) ' Правая нога
        Граф.DrawEllipse(Pens.Black, 310, 170, 60, 100) ' Туловище (вертикальный эллипс)
        Граф.DrawEllipse(Pens.Black, 325, 140, 30, 30)  ' Голова
        Граф.DrawRectangle(Pens.Black, 325, 110, 30, 30) ' Шляпа
        Граф.DrawLine(Pens.Black, 315, 220, 270, 260) ' Левая рука
        Граф.DrawLine(Pens.Black, 365, 220, 430, 220) ' Правая рука (указывает вперед)

        ' ==========================================
        ' 3. ПАРОВОЗ (правая часть)
        ' ==========================================
        Граф.DrawRectangle(Pens.Black, 470, 200, 60, 110) ' Кабина
        Граф.DrawRectangle(Pens.Black, 530, 250, 70, 60)  ' Котел
        Граф.DrawEllipse(Pens.Black, 480, 310, 40, 40)    ' Заднее колесо
        Граф.DrawEllipse(Pens.Black, 550, 310, 40, 40)    ' Переднее колесо

        ' Труба (строится из трех пересекающихся отрезков)
        Граф.DrawLine(Pens.Black, 575, 250, 565, 200) ' Левая стенка трубы
        Граф.DrawLine(Pens.Black, 585, 250, 595, 200) ' Правая стенка трубы
        Граф.DrawLine(Pens.Black, 565, 200, 595, 200) ' Верх трубы

        ' Дым (эллипсы)
        Граф.DrawEllipse(Pens.Black, 550, 160, 40, 15) ' Малое облако дыма
        Граф.DrawEllipse(Pens.Black, 510, 120, 60, 20) ' Большое облако дыма
    End Sub

End Class